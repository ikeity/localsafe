<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认清理所选项" Width="760" Height="640" ResizeMode="CanResize" Background="White" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#202326" UseLayoutRounding="True">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock x:Name="Count" FontSize="22" FontWeight="Medium"/>
   <TextBlock Text="目录将隔离保留，系统登记先备份再移除。恢复系统登记需按备份人工处理。" TextWrapping="Wrap" Foreground="#697176" Margin="0,10,0,0"/>
  </StackPanel>
  <ListBox x:Name="Targets" Grid.Row="1" BorderBrush="#E5EAE7" BorderThickness="1" Background="#F7F9F8"
           ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           HorizontalContentAlignment="Stretch" AutomationProperties.Name="本次确认清理的完整项目清单">
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,8">
    <TextBlock Text="{Binding ActionLabel}" FontWeight="Medium" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Name}" Margin="0,4,0,0" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Reference}" Foreground="#697176" Margin="0,4,0,0" TextWrapping="Wrap"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="Cancel" Content="取消" IsCancel="True" MinWidth="96" Padding="16,9" Margin="0,0,10,0"/>
   <Button x:Name="Confirm" Content="确认清理" MinWidth="120" Padding="16,9" Background="#17635B" Foreground="White" BorderBrush="#17635B"/>
  </StackPanel>
 </Grid>
</Window>
